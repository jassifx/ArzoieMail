# Line endings
#
# Text files are stored with LF in the repository and checked out with the platform's line
# ending, unless a rule below fixes the ending because the file's consumer depends on it.
* text=auto

# Windows-only formats, checked out with CRLF everywhere. cmd.exe misparses labels and GOTO in a
# batch file with LF endings, and the Visual Studio, Inno Setup and resource compiler files are
# only ever edited on Windows.
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf
*.psm1      text eol=crlf
*.psd1      text eol=crlf
*.sln       text eol=crlf
*.vcxproj   text eol=crlf
*.filters   text eol=crlf
*.csproj    text eol=crlf
*.props     text eol=crlf
*.targets   text eol=crlf
*.iss       text eol=crlf
*.rc        text eol=crlf
*.reg       text eol=crlf

# Shell scripts run with LF wherever they are checked out.
*.sh        text eol=lf

# Test messages, checked out with CRLF everywhere: SMTP lines end in CRLF, and the DKIM
# signatures in them cover the exact bytes, so an LF checkout would invalidate them.
*.eml       text eol=crlf

# Binary files: never converted, never diffed as text.
*.ico       binary
*.png       binary
*.gif       binary
*.jpg       binary
*.jpeg      binary
*.bmp       binary
*.pfx       binary
*.p12       binary
*.der       binary
*.dll       binary
*.exe       binary
*.msi       binary
*.lib       binary
*.tlb       binary
*.sdf       binary
*.zip       binary
*.7z        binary

# Fuzzing inputs are test data, kept byte for byte: a carriage return in one is part of the input.
hmailserver/source/Server/Portable/Fuzz/corpus/** -text

# Language-aware diffs (hunk headers name the function a change is in).
*.cpp       diff=cpp
*.h         diff=cpp
*.cs        diff=csharp
*.php       diff=php
*.md        diff=markdown
*.html      diff=html
*.css       diff=css

# GitHub language statistics: the vendored icon set and the documentation are not project code.
libraries/fat_cow_icons/** linguist-vendored
hmailserver/documentation/** linguist-documentation
