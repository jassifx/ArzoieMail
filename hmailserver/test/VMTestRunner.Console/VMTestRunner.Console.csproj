<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <!-- Properties\AssemblyInfo.cs carries the title, company, product and version; the SDK
         generates the rest, including SupportedOSPlatform. -->
    <GenerateAssemblyTitleAttribute>false</GenerateAssemblyTitleAttribute>
    <GenerateAssemblyDescriptionAttribute>false</GenerateAssemblyDescriptionAttribute>
    <GenerateAssemblyConfigurationAttribute>false</GenerateAssemblyConfigurationAttribute>
    <GenerateAssemblyCompanyAttribute>false</GenerateAssemblyCompanyAttribute>
    <GenerateAssemblyProductAttribute>false</GenerateAssemblyProductAttribute>
    <GenerateAssemblyCopyrightAttribute>false</GenerateAssemblyCopyrightAttribute>
    <GenerateAssemblyVersionAttribute>false</GenerateAssemblyVersionAttribute>
    <GenerateAssemblyFileVersionAttribute>false</GenerateAssemblyFileVersionAttribute>
    <GenerateAssemblyInformationalVersionAttribute>false</GenerateAssemblyInformationalVersionAttribute>
    <!-- The item lists below are explicit, as they were before the move to .NET 10. -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
    <OutputPath>bin\$(Platform)\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <OutputType>Exe</OutputType>
    <AssemblyName>VMTestRunner.Console</AssemblyName>
    <RootNamespace>VMTestRunner.Console</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommandLineParser" />
    <PackageReference Include="Microsoft.PowerShell.SDK" />
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="NLog" />
    <PackageReference Include="System.Management" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\RegressionTests\Infrastructure\RetryHelper.cs">
      <Link>RetryHelper.cs</Link>
    </Compile>
    <Compile Include="Configuration\TestEnvironments.cs" />
    <Compile Include="Infrastructure\CompletionEstimator.cs" />
    <Compile Include="Infrastructure\Guest\GuestSession.cs" />
    <Compile Include="Infrastructure\Guest\IGuestSession.cs" />
    <Compile Include="Infrastructure\Guest\NetworkGuestSession.cs" />
    <Compile Include="Infrastructure\Guest\NetworkShare.cs" />
    <Compile Include="Infrastructure\Guest\PowerShellDirectGuestSession.cs" />
    <Compile Include="Infrastructure\HyperV.cs" />
    <Compile Include="Infrastructure\NUnitResultParser.cs" />
    <Compile Include="Infrastructure\RunContext.cs" />
    <Compile Include="Infrastructure\TestBoardConsoleTarget.cs" />
    <Compile Include="Infrastructure\TestResultWriter.cs" />
    <Compile Include="Infrastructure\TestStatusBoard.cs" />
    <Compile Include="Infrastructure\TestFailedException.cs" />
    <Compile Include="Infrastructure\TestRunner.cs" />
    <Compile Include="Infrastructure\TestSettings.cs" />
    <Compile Include="Models\FileCopyCommand.cs" />
    <Compile Include="Models\GuestTransport.cs" />
    <Compile Include="Models\TestSuite.cs" />
    <Compile Include="Models\InstallCommand.cs" />
    <Compile Include="Models\TestEnvironment.cs" />
    <Compile Include="Models\TestRunReport.cs" />
    <Compile Include="Models\TestRunResult.cs" />
    <Compile Include="Options.cs" />
    <Compile Include="Program.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
    <None Include="NLog.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="RunTestsInHyperV.bat">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <Content Include="TestEnvironments.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
