<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Product release version follows the repository; assembly identity remains stable. -->
    <VersionPrefix>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)..\..\..\..\VERSION').Trim())</VersionPrefix>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <Product>ArzoieMail</Product>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
  </PropertyGroup>
  <ItemGroup>
    <!-- Runs the installed panel as a Windows service; Microsoft's package, pinned with the bundled runtime. -->
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.13" />
  </ItemGroup>
</Project>
